{
  "name": "astro-dev-island-hydration-advisor",
  "version": "1.0.0",
  "description": "Astro Dev Toolbar app that analyzes island hydration directives and uses Chrome Built-in AI (Gemini Nano) to advise on performance optimizations.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./src/app.ts",
      "import": "./dist/app.js",
      "default": "./dist/app.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/app.ts --outdir ./dist",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit"
  },
  "peerDependencies": {
    "astro": ">=5.0.0 <8.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "astro": "^5.4.0",
    "typescript": "^5.8.0"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "astro-dev-toolbar",
    "islands",
    "hydration",
    "performance",
    "chrome-ai",
    "gemini-nano",
    "web-vitals"
  ],
  "author": "Antigravity",
  "license": "MIT"
}
